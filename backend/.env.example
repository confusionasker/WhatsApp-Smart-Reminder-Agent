# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production

# MySQL Database
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=whatsapp_reminder

# WhatsApp Provider Configuration:
# - 'qr'   : WhatsApp Web via QR Code (Recommended: No Meta account or Token needed!)
# - 'meta' : Meta WhatsApp Cloud API (Requires Facebook Developer Account)
# - 'demo' : Simulated Sending (No real messages sent)
WHATSAPP_PROVIDER=qr
WHATSAPP_GATEWAY_URL=http://localhost:3001

# Meta WhatsApp Cloud API (Optional - only needed if WHATSAPP_PROVIDER=meta)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_API_VERSION=v21.0

# Ollama AI (Optional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:latest

# Demo Mode
DEMO_MODE=False
